+        p.insert(block)
+        p.remove(block)
+        p.touch(block)
+        p.insert(block)
+        p._p = float(p._capacity)  # force T2 eviction
+        p.evict_n(1)
+        assert p.b2_size == 1
+        assert p.b1_size == 0
+
+    def test_eviction_from_t2_demotes_block(self):
+        p = self._make()
+        block = KVCacheBlock(9)
+        p.insert(block)
+        p.remove(block)
+        p.touch(block)
