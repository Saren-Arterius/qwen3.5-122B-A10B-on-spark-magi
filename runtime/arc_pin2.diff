+                self._pin_needle = ids[1:-1] if len(ids) > 2 else ids
+                num_gpu_blocks = self.kv_cache_manager.block_pool.num_gpu_blocks
+                logger.info(
+                    "[never-evict] armed: %d-token marker, pin capped at %d "
