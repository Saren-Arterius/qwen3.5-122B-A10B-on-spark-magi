+# ---------------------------------------------------------------------------
+# Never-evict pinning (--never-evict-kv-cache-prompt-includes)
+# ---------------------------------------------------------------------------
+
+
+def _hash(i: int, group_id: int = 0):
+    from vllm.v1.core.kv_cache_utils import BlockHash, make_block_hash_with_group_id
+
+    return make_block_hash_with_group_id(BlockHash(b"hash-%04d" % i), group_id)
+
+
+class TestPinning:
+    def _make_pool(self, num_blocks: int = 100):
+        from vllm.v1.core.block_pool import BlockPool
+
+        return BlockPool(
+            num_gpu_blocks=num_blocks,
+            enable_caching=True,
+            hash_block_size=16,
+            eviction_policy="arc",
+        )
+
+    def _cached(self, pool, n: int, first: int = 0, group_id: int = 0):
+        """n blocks carrying hashes, as cache_full_blocks would leave them.
+
+        Registering in cached_block_hash_to_block matters: that map is what
+        _maybe_evict_cached_block consults to reset a hash on reuse, so
+        without it an evicted block would keep a stale hash and the test
+        could not tell a survivor from a recycled block.
+        """
+        blocks = pool.get_new_blocks(n)
+        for offset, block in enumerate(blocks):
+            key = _hash(first + offset, group_id)
+            block.block_hash = key
+            pool.cached_block_hash_to_block.insert(key, block)
+        return blocks
+
+    def test_pinned_blocks_are_not_free(self):
+        """A hard pin must leave the free count, or the scheduler would hand
+        the blocks out and evict_n would have to break the guarantee."""
+        pool = self._make_pool()
+        blocks = self._cached(pool, 5)
+        pool.set_pinned_hashes({b.block_hash for b in blocks}, 0.25)
+
+        pool.free_blocks(list(reversed(blocks)))
+        assert pool.get_num_free_blocks() == 94
+        assert pool._policy.pin_size == 5
+
+    def test_survives_mid_request_free_then_churn(self):
+        """The regression this pin exists for.
+
+        A hybrid model hands cached blocks back *while the request is still
+        running* — MambaManager.get_num_skipped_tokens() is
+        num_computed_tokens - 1, so remove_skipped_blocks() frees the state
+        block on every step. The old id-keyed pin snapshotted the block table
+        when the request finished and so never saw them; churn then evicted
+        them, and because find_longest_cache_hit is a fixed point across all
+        KV cache groups, that one group's miss truncated the whole hit to 0.
+
+        The property that fixes it, and the one asserted here: the pin is
+        armed from what the request knows on arrival (its hashes) and claimed
+        lazily as blocks are freed, so a block freed at *any* point in the
+        request's life is held. The old API could not express this — it needed
+        block ids, which are only knowable after the fact.
+        """
+        pool = self._make_pool(100)
+        prefix = self._cached(pool, 8)
+        pool.set_pinned_hashes({b.block_hash for b in prefix}, 0.25)
+
+        # Mid-request release: the request is nowhere near finished, but these
+        # blocks are already back in the pool.
+        pool.free_blocks(list(reversed(prefix)))
+        prefix_ids = {b.block_id for b in prefix}
+
+        # Now churn far past the pool's capacity.
+        for round_ in range(20):
+            junk = self._cached(pool, 50, first=1000 + round_ * 50)
+            pool.free_blocks(list(reversed(junk)))
+
+        assert pool._policy.pin_size == 8
+        for block in prefix:
+            assert block.block_id in prefix_ids
+            assert block.block_hash is not None, "hash was reset -> block reused"
+            assert pool.cached_block_hash_to_block.get_one_block(block.block_hash) is (
+                block
+            )
+
+    def test_loaned_pinned_block_comes_back_to_the_pin(self):
+        """A prefix hit takes a pinned block out on loan; it must return."""
+        pool = self._make_pool()
+        blocks = self._cached(pool, 4)
+        pool.set_pinned_hashes({b.block_hash for b in blocks}, 0.25)
+        pool.free_blocks(list(reversed(blocks)))
+        assert pool._policy.pin_held == 4
+
+        pool.touch(blocks)  # prefix-cache hit
+        assert pool._policy.pin_held == 0
+        assert pool._policy.pin_size == 4  # still reserved, just on loan
+        assert pool.get_num_free_blocks() == 95
+
+        pool.free_blocks(list(reversed(blocks)))
+        assert pool._policy.pin_held == 4
+        assert pool.get_num_free_blocks() == 95
+
+    def test_evict_n_never_returns_pinned(self):
+        pool = self._make_pool()
+        keep = self._cached(pool, 4)
+        churn = self._cached(pool, 20, first=100)
+        pool.set_pinned_hashes({b.block_hash for b in keep}, 0.25)
+        pool.free_blocks(list(reversed(keep)))
+        pool.free_blocks(list(reversed(churn)))
+
+        keep_ids = {b.block_id for b in keep}
+        evicted = pool._policy.evict_n(pool.get_num_free_blocks())
+        assert not keep_ids.intersection(b.block_id for b in evicted)
+        assert pool.get_num_free_blocks() == 0
+        assert pool._policy.pin_size == 4
+
+    def test_new_pin_releases_the_old_one(self):
+        """A new marker prompt replaces the pin set; the old blocks go back."""
+        pool = self._make_pool()
+        old = self._cached(pool, 3)
+        new = self._cached(pool, 3, first=50)
+
+        pool.set_pinned_hashes({b.block_hash for b in old}, 0.25)
+        pool.free_blocks(list(reversed(old)))
+        pool.free_blocks(list(reversed(new)))
+        assert pool._policy.pin_size == 3
+        free_with_old_pinned = pool.get_num_free_blocks()
+
+        pool.set_pinned_hashes({b.block_hash for b in new}, 0.25)
+        # `new` is already sitting in T1, so the pin is acquired lazily, the
+        # next time those blocks pass through insert(). In the real flow the
+        # marked request touches them (prefix hit) and frees them again.
+        pool.touch(new)
+        pool.free_blocks(list(reversed(new)))
+        assert pool._policy.pin_size == 3
+        assert pool.get_num_free_blocks() == free_with_old_pinned
+
+        # The released blocks are evictable again, the newly pinned ones are
+        # not. Released blocks re-enter at T1's tail (MRU) rather than its
+        # head, so drain the whole pool rather than assuming an order.
+        evicted_ids = {
+            b.block_id for b in pool._policy.evict_n(pool.get_num_free_blocks())
+        }
+        assert {b.block_id for b in old}.issubset(evicted_ids)
+        assert not evicted_ids.intersection(b.block_id for b in new)
+
+    def test_pin_is_capped(self):
+        pool = self._make_pool(100)
+        blocks = self._cached(pool, 50)
+
+        pool.set_pinned_hashes({b.block_hash for b in blocks}, 0.25)
+        pool.free_blocks(list(reversed(blocks)))
+        assert pool._policy.pin_size == 25  # 25% of 100
+        assert pool.get_num_free_blocks() == 74  # 99 free - 25 pinned
+
+    def test_reset_prefix_cache_drops_pins(self):
+        pool = self._make_pool()
+        blocks = self._cached(pool, 5)
+        pool.set_pinned_hashes({b.block_hash for b in blocks}, 0.25)
+        pool.free_blocks(list(reversed(blocks)))
+        assert pool.get_num_free_blocks() == 94
+
+        assert pool.reset_prefix_cache() is True
+        assert pool._policy.pin_size == 0
+        assert pool.get_num_free_blocks() == 99
+
+    def test_prepend_still_evicts_first(self):
+        """free_blocks(prepend=True) means 'reuse these first'."""
+        pool = self._make_pool()
+        normal = pool.get_new_blocks(3)
+        junk = pool.get_new_blocks(3)
+        pool.free_blocks(list(reversed(normal)))
+        pool.free_blocks(list(reversed(junk)), prepend=True)
+
+        evicted = {b.block_id for b in pool._policy.evict_n(3)}
+        assert evicted == {b.block_id for b in junk}
+
