+class TestContainsSubseq:
+    def test_matches_and_rejects(self):
+        from vllm.v1.core.sched.scheduler import _contains_subseq
+
+        assert _contains_subseq([1, 2, 3, 4, 5], [3, 4])
+        assert _contains_subseq([1, 2, 3], [1, 2, 3])
+        assert not _contains_subseq([1, 2, 3], [3, 2])
+        assert not _contains_subseq([1, 2], [1, 2, 3])
+        assert not _contains_subseq([1, 2, 3], [])
+        # Restarts the scan after a partial match.
+        assert _contains_subseq([7, 7, 8], [7, 8])
