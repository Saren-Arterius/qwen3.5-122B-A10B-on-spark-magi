+    if cls is None:
+        raise ValueError(
+            f"Unknown GPU eviction policy {name!r}. "
+            f"Valid options: {sorted(VALID_GPU_EVICTION_POLICIES)}"
+        )
+    if name == "arc":
+        return cls(capacity=capacity)  # type: ignore[call-arg]
+    return cls()
+
